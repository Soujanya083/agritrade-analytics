# ---- Database -------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/agribid
PORT=8000
# Set to false if your network's own DNS resolves mongodb+srv:// fine
# (the default forces public resolvers 8.8.8.8 / 1.1.1.1).
# MONGO_USE_PUBLIC_DNS=true

# ---- Authentication (REQUIRED in production) --------------------------------
# Must be IDENTICAL to JWT_SECRET in server/.env - this service verifies the
# tokens the Node backend issues. Without it, production returns 503 for every
# analytics request (it never falls back to a public default when deployed).
JWT_SECRET=
# Optional key for trusted server-to-server callers (sent as X-Internal-Api-Key).
# Leave empty to disable that path entirely.
ANALYTICS_INTERNAL_API_KEY=

# ---- CORS ---------------------------------------------------------------------
# Comma-separated frontend origins. Empty = allow all (OK for local dev only).
# CORS_ORIGINS=https://your-frontend.vercel.app

# ---- Mandi prices (data.gov.in AGMARKNET) ---------------------------------------
# Without these the service serves a small cached snapshot (onion only) and says so.
DATAGOVIN_API_KEY=
DATAGOVIN_RESOURCE_ID=

# ---- Chatbot: general agriculture Q&A via an LLM (OPTIONAL) -----------------------
# Project-data questions (prices, demand, where to sell...) work WITHOUT any of this.
# Leave LLM_PROVIDER empty and the bot says plainly that general Q&A is unavailable.
#   LLM_PROVIDER=anthropic   -> LLM_API_KEY required; LLM_MODEL optional
#   LLM_PROVIDER=openai      -> any OpenAI-compatible API (OpenAI, Groq, Gemini's
#                               OpenAI endpoint, local Ollama): LLM_MODEL required,
#                               LLM_BASE_URL optional (e.g. http://localhost:11434/v1)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# CHATBOT_LLM_MAX_PER_WINDOW=20        # LLM-backed questions per user ...
# CHATBOT_LLM_WINDOW_SECONDS=600       # ... per this many seconds

# Requests per minute one signed-in user may send to the analytics service (default 240).
# ANALYTICS_RATE_LIMIT_PER_MIN=240
