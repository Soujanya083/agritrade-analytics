# Copy to .env.local for local development. These values are PUBLIC (they end up in the browser):
# never put a secret here.
REACT_APP_API_BASE_URL=http://localhost:5000/api
REACT_APP_ANALYTICS_BASE_URL=http://localhost:8000/api/analytics
# Demo payment details shown for the manual UPI flow (demo only; see README, Security).
REACT_APP_UPI_ID=
REACT_APP_UPI_NAME=
