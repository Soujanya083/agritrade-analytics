# ---- Required when deployed ---------------------------------------------------
# Long random string. The analytics service must use the SAME value.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
MONGO_URI=mongodb://localhost:27017/agribid
PORT=5000

# ---- CORS / proxy ---------------------------------------------------------------
# Comma-separated frontend origins. Empty = allow all (local dev only).
# CORS_ORIGINS=https://your-frontend.vercel.app
# Number of reverse-proxy hops (Render = 1). Needed so rate limits are per-user, not global.
# TRUST_PROXY=1

# ---- Accounts ---------------------------------------------------------------------
# No email/SMS provider exists yet, so by default the OTP is returned in the API
# response (demo mode). Set to false once a real sender is wired in.
# EXPOSE_OTP_IN_RESPONSE=true

# ---- Crop photos (optional) -----------------------------------------------------------
# Free key from https://www.pexels.com/api/ . Without it, listings without an uploaded
# photo show a labelled icon instead of a stock photo.
# Optional. Without it, crop photos come from Wikipedia automatically (set CROP_PHOTO_WIKIPEDIA=false to disable).
PEXELS_API_KEY=

# ---- Payments (optional) ---------------------------------------------------------------
# Without these, online payment is disabled and the manual UPI flow is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
