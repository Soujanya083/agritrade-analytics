# ---- Required when deployed ---------------------------------------------------
# Long random string. The analytics service must use the SAME value.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
MONGO_URI=mongodb://localhost:27017/agribid
PORT=5000

# ---- CORS / proxy ---------------------------------------------------------------
# Comma-separated frontend origins. Empty = allow all (local dev only).
# CORS_ORIGINS=https://your-frontend.vercel.app
# Number of reverse-proxy hops (Render = 1). Needed so rate limits are per-user, not global.
# TRUST_PROXY=1

# ---- Accounts: sessions ---------------------------------------------------------------
# Access tokens are short-lived and kept in the browser's memory only. A rotating httpOnly cookie
# keeps people logged in (see server/lib/refreshTokens.js). Needs CORS_ORIGINS when deployed.
# JWT_ACCESS_TTL=30m
# REFRESH_TTL_DAYS=7

# ---- Accounts: verification e-mail (OTP) --------------------------------------------------
# With NO provider below, the OTP is returned in the API response (DEMO MODE: proves nothing).
# With a provider configured the OTP is e-mailed and is never returned by the API.
# Free options (see docs/PAYMENTS_AND_OTP.md):
#   Brevo : EMAIL_PROVIDER=brevo  + BREVO_API_KEY=...  + OTP_FROM_EMAIL=<a sender you verified in Brevo>
#   Resend: EMAIL_PROVIDER=resend + RESEND_API_KEY=... + OTP_FROM_EMAIL=<an address on a domain you verified>
# EMAIL_PROVIDER=
# BREVO_API_KEY=
# RESEND_API_KEY=
# OTP_FROM_EMAIL=
# OTP_APP_NAME=AgriTrade
# Force the old behaviour either way (true = echo the OTP, false = never echo):
# EXPOSE_OTP_IN_RESPONSE=

# ---- Crop photos (all optional) ---------------------------------------------------------
# Order: the farmer's own upload, a hand-picked photo (server/data/cropPhotoOverrides.json, see
# docs/CROP_PHOTOS.md), Pexels (needs the key below), the crop's Wikipedia photo, then a drawn icon.
# Free Pexels key: https://www.pexels.com/api/
PEXELS_API_KEY=
# Set to false to stop looking up Wikipedia photos.
# CROP_PHOTO_WIKIPEDIA=true
# Login attempts allowed per IP per 15 minutes (default 20).
# AUTH_RATE_LIMIT_MAX=20

# ---- Payments (optional) ---------------------------------------------------------------
# Without these, online payment is disabled and the manual UPI flow is used (DEMO ONLY: it trusts the buyer's
# word). With them set, the manual route is switched off and payments are verified by signature.
# Use Razorpay TEST keys (rzp_test_...) for the project: the full real flow, with fake money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Shipments: tracking, delivery code and alerts (docs/SHIPMENT_SAFETY.md) ---------------------------------
# Base address used inside the QR code link (defaults to the first CORS_ORIGINS entry).
# PUBLIC_APP_URL=https://your-app.vercel.app
# People allowed to see and resolve ANY shipment (comma-separated e-mails).
# SHIPMENT_ADMIN_EMAILS=
# The delivery code is e-mailed to the buyer when EMAIL_PROVIDER (above) is configured. Without it, the buyer's own
# request returns the code ONLY in development. Set to true to allow this in a demo deployment (it is labelled on screen).
# EXPOSE_DELIVERY_OTP_IN_RESPONSE=
# DELIVERY_OTP_TTL_MINUTES=60
# DELIVERY_OTP_MAX_ATTEMPTS=5
# DELIVERY_OTP_LOCK_MINUTES=15
# SHIPMENT_PHOTO_MAX_BYTES=2097152
# TRACKING_ALLOW_SIMULATION=false
# Alert rules (defaults shown) - see the table in docs/SHIPMENT_SAFETY.md
# ALERT_DELAY_GRACE_MINUTES=60
# ALERT_STALE_HOURS=12
# ALERT_QUANTITY_TOLERANCE_PERCENT=2
# ALERT_DAMAGE_CRITICAL_PERCENT=25
# ALERT_SWEEP_INTERVAL_MINUTES=10
